# === Database ===
# Local Docker Postgres (required so setup scripts hit the same DB as the dashboard).
# Inside containers compose already sets DATABASE_URL to host "postgres".
# DATABASE_URL=postgresql://alfredo_user:alfredo_password@localhost:5432/alfredo_db

GEMINI_API_KEY=""
COMPLEX_LLM="gemini/gemini-2.5-pro"

# === Headroom AI — Context Compression ===
# Reduces token usage 60-95% automatically for all LLM calls.
# HEADROOM_ENABLED=true activates the inline compression (no extra process needed).
# Optionally set HEADROOM_PROXY_URL to use the proxy for the live dashboard.
# - Per esecuzione locale: HEADROOM_PROXY_URL="http://localhost:8787/v1"
# - Per esecuzione Docker: HEADROOM_PROXY_URL="http://headroom_proxy:8787/v1"
HEADROOM_ENABLED="true"
HEADROOM_PROXY_URL="http://headroom_proxy:8787/v1"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""
MASTER_AI_MODEL_ID="3"

# === Alfredo API Server ===
# Port for the REST API (used by external app SDK)
ALFREDO_API_PORT=8000
# Token required by the Control API (/api/assistant/*, /api/runs, /api/interrupts)
# used by the mobile app. Send it as the X-Control-Token header.
# Leave empty only on a trusted single machine: the endpoints are then open.
# ALFREDO_CONTROL_TOKEN="change-me-long-random-string"

# === Web Push (approval notifications in the mobile PWA) ===
# Optional: when empty, Alfredo generates VAPID keys once and stores them in
# config/push_vapid.json (kept out of git). The phone subscribes from
# Impostazioni → Notifiche push, then approvals arrive even with the app closed.
# ALFREDO_VAPID_PUBLIC_KEY="base64url-public-key"
# ALFREDO_VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ALFREDO_VAPID_SUBJECT="mailto:you@example.com"

# === Automation scheduler ===
# Window (minutes) in which a missed interval/daily trigger is still executed
# once after a restart. Older missed triggers are skipped and noted in
# config/automations_state.json (rule-level `catchup_minutes` overrides this).
# ALFREDO_SCHEDULER_CATCHUP_MINUTES=720
# Hard cap on events kept per run in the append-only event log.
# ALFREDO_RUN_EVENTS_MAX=5000

# Secret used to sign short-lived file share links. If unset, Alfredo uses
# config/share_secret.txt and generates it on first use.
# ALFREDO_SHARE_SECRET=change-me
# Public base URL used when building share links (defaults to the request URL).
# ALFREDO_PUBLIC_URL=https://alfredo.example.com
# Chunked uploads: total size cap (MB) and stale-session TTL (minutes).
# ALFREDO_MAX_UPLOAD_MB=512
# ALFREDO_UPLOAD_TTL_MINUTES=1440

# === GPU gate (single-flight FIFO queue on the local LLM) ===
# Two profiles: fast (7-8B Q4) and deep (14B Q4). Sizes are estimates in MB.
# ALFREDO_GPU_FAST_MODEL=llama3:8b-instruct-q4_K_M
# ALFREDO_GPU_FAST_CTX=8192
# ALFREDO_GPU_FAST_VRAM_MB=6500
# ALFREDO_GPU_DEEP_MODEL=deepseek-r1:14b
# ALFREDO_GPU_DEEP_CTX=8192
# ALFREDO_GPU_DEEP_VRAM_MB=9800
# VRAM kept free for the desktop, max queue wait (seconds), preload on switch.
# ALFREDO_GPU_RESERVE_MB=768
# ALFREDO_GPU_QUEUE_TIMEOUT=120
# ALFREDO_GPU_PRELOAD=1
# ALFREDO_GPU_KEEP_ALIVE=10m

# === Ollama Cloud / Remote ===
# If using Ollama Cloud or a remote server, specify the base URL and API key.
# OLLAMA_API_BASE="https://api.ollama.com"
# OLLAMA_API_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID9ZiYv7xdytcxCe3gQp9P7e7aSIm3pFOYc2OIIk9G2k"

# === LM Studio / Bionic (local OpenAI-compatible server) ===
# Bionic and LM Studio share a GGUF folder. Default is this user's ~/.lmstudio/models.
# On another computer, set LMSTUDIO_MODELS_DIR to that machine's folder (or use the UI).
# Start the server in LM Studio → Developer → Local Server, then:
# LMSTUDIO_API_BASE="http://127.0.0.1:1234"
# LMSTUDIO_MODELS_DIR="C:\Users\Pietro\.lmstudio\models"
# From Docker: LMSTUDIO_API_BASE="http://host.docker.internal:1234"
# LMSTUDIO_API_KEY="lm-studio"

# === External App Credentials (examples) ===
# These are referenced by name in the 'apps' table.
# When you register an app, set db_env_key="MY_APP_DB_URL" and
# the tool will read os.getenv("MY_APP_DB_URL") at runtime.
#
# MY_APP_DB_URL="sqlite:///path/to/app_database.db"
# MY_APP_DB_URL="postgresql://user:password@localhost:5432/my_app_db"
# MY_APP_API_KEY="sk-your-app-api-key-here"

# === Local Model Training (optional) ===
# HuggingFace token for downloading gated models (e.g. Llama 3)
# Get yours at: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=""

# === Workflow Hub (optional — share workflows with coworkers) ===
# Client settings (each Alfredo instance):
# HUB_MODE=off          # off | local | remote
# HUB_API_URL=http://psid.us:8010
# HUB_ORG=psid
# HUB_USERNAME=
# HUB_DISPLAY_NAME=
# HUB_TOKEN=            # from Share/Hub → Register — never commit
# HUB_SERVER_ROLE=client   # client | server_admin (UI preference on this PC)
#
# Server settings (hub container only — see deploy/psid/.env.hub.example):
# HUB_REGISTRATION=invite
# HUB_INVITE_TOKEN=
# HUB_REQUIRED_ORG=psid
# HUB_ALLOW_PUBLIC=false
#
# Remote Ollama on company server (colleagues use server GPU):
# OLLAMA_API_BASE=http://psid.us:11434
# See docs/PSID_HUB.md for full LAN setup.
